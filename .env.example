# --- Alibaba Cloud Agent Sandbox (阿里云智能体沙箱) ---
# API Key 在 Agent Sandbox 控制台「API Key」页面创建（形如 e2b_xxx）
E2B_API_KEY="e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 地域，默认 cn-hangzhou
REGION="cn-hangzhou"
# 可选：显式覆盖域名 / API 地址（一般无需设置）
# E2B_DOMAIN="cn-hangzhou.sandbox.aliyuncs.com"
# E2B_API_URL="https://api.cn-hangzhou.sandbox.aliyuncs.com"
# 可选：默认模板、超时与输出上限
# E2B_TEMPLATE="code-interpreter-v1"
# SANDBOX_TIMEOUT_MS="300000"
# SANDBOX_MAX_OUTPUT_CHARS="30000"
